# See https://help.github.com/articles/ignoring-files/

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / build output
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo

# Tests & coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Env files with secrets (keep `.env.example` committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS
.DS_Store
Thumbs.db

# Editors / local IDE (not needed on remote)
.idea/
.vscode/
*.swp
*.swo
*~

# Keys & local TLS material
*.pem
*.key
*.p12

# Merge / patch leftovers
*.orig
