

# --- Google Gemini (optional; powers daily brief + todo assistant) -------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_BRIEF_CACHE_SECONDS=300

# --- Postgres (Prisma) ---------------------------------------------------
# Runtime: PrismaClient. Migrate: prisma.config.ts / `npx prisma migrate deploy`.
# Local single DB: set both to the same connection string.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth (required for sign-in) --------------------------------
# Create a project at https://supabase.com — Authentication → enable Email.
# Site URL / redirect: add http://localhost:3000 and your production URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=